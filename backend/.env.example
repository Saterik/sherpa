# Application
APP_ENV=development
APP_DEBUG=true
APP_SECRET=your-secret-key-change-in-production
APP_URL=http://localhost:8080

# Database
DATABASE_DRIVER=pdo_pgsql
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=sherpa
DATABASE_USER=sherpa
DATABASE_PASSWORD=sherpa_password
DATABASE_URL=postgresql://sherpa:sherpa_password@db:5432/sherpa

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_MIME_TYPES=application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

# Image Storage
IMAGE_STORAGE_PATH=/var/www/html/storage/images
IMAGE_PUBLIC_PATH=/storage/images

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:4200