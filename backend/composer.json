{
    "name": "sherpa/product-import",
    "description": "Product Import/Export Application - Backend",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "doctrine/dbal": "^4.0",
        "doctrine/migrations": "^3.7",
        "doctrine/orm": "^3.0",
        "guzzlehttp/guzzle": "^7.8",
        "monolog/monolog": "^3.4",
        "php-amqplib/php-amqplib": "^3.6",
        "php-di/php-di": "^7.1",
        "phpoffice/phpspreadsheet": "^2.2",
        "ramsey/uuid": "^4.7",
        "ramsey/uuid-doctrine": "^2.1",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.12",
        "swagger-api/swagger-ui": "^4.18",
        "symfony/console": "^6.4",
        "symfony/messenger": "^6.4",
        "symfony/var-exporter": "^7.4",
        "tuupola/slim-jwt-auth": "^3.7",
        "vlucas/phpdotenv": "^5.6",
        "zircote/swagger-php": "^4.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.11",
        "friendsofphp/php-cs-fixer": "^3.50",
        "doctrine/doctrine-fixtures-bundle": "^3.5",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "start": "php -S 0.0.0.0:8080 -t public",
        "migrate": "php vendor/bin/doctrine-migrations migrate --no-interaction",
        "migrate:diff": "php vendor/bin/doctrine-migrations diff",
        "test": "php vendor/bin/phpunit",
        "phpstan": "php vendor/bin/phpstan analyse src --level=5",
        "cs-fix": "php vendor/bin/php-cs-fixer fix --allow-risky=yes",
        "cs-check": "php vendor/bin/php-cs-fixer fix --dry-run --diff --allow-risky=yes",
        "generate-swagger": "php vendor/bin/openapi src -o public/swagger.json"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "sort-packages": true,
        "audit": {
            "ignore": [
                "PKSA-y2cr-5h3j-g3ys",
                "PKSA-2kqm-ps5x-s4f5"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
